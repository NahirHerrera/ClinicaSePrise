<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.AsistencialPage"
             Title="Servicios Asistenciales y Diagnóstico"
             BackgroundColor="#FAF5FF">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🚪 Cerrar Sesión" 
                  Clicked="OnCerrarSesionClicked" 
                  Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Servicios Diagnósticos (Rayos X, Ecografía, RM)" FontSize="22" FontAttributes="Bold" TextColor="#6B21A8"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Frame Grid.Column="0" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Estudios Realizados Hoy" FontSize="18" FontAttributes="Bold"/>
                        <CollectionView x:Name="cvEstudiosHoy" HeightRequest="200"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Stock de Insumos Diagnósticos" FontSize="18" FontAttributes="Bold"/>
                        <Button Text="Solicitar Reposición de Placas / Gel" BackgroundColor="#9333EA" TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>