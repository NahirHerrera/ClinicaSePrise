<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:ClinicaSePrise.Entidades"
             x:Class="ClinicaSePrise.Vistas.StockPage">
    <VerticalStackLayout Spacing="10">
        <Label x:Name="lblResumen" FontSize="16" FontAttributes="Bold" />
        <Grid ColumnDefinitions="3*,*,*,*,*" Padding="8,0">
            <Label Text="Insumo" FontAttributes="Bold" TextColor="Grey"/>
            <Label Grid.Column="1" Text="Stock" FontAttributes="Bold" TextColor="Grey"/>
            <Label Grid.Column="2" Text="Mínimo" FontAttributes="Bold" TextColor="Grey"/>
            <Label Grid.Column="3" Text="Estado" FontAttributes="Bold" TextColor="Grey"/>
        </Grid>
        <CollectionView x:Name="lista">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ent:InsumoStock">
                    <Grid ColumnDefinitions="3*,*,*,*,*" Padding="8">
                        <Label Text="{Binding nombre}" VerticalOptions="Center" TextColor="Grey"/>
                        <Label Grid.Column="1" Text="{Binding stock}" VerticalOptions="Center" TextColor="Grey"/>
                        <Label Grid.Column="2" Text="{Binding stockMinimo}" VerticalOptions="Center" TextColor="Grey"/>
                        <Label Grid.Column="3" Text="{Binding estadoReposicion}" TextColor="Green" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding estadoReposicion}" Value="Reposición">
                                    <Setter Property="TextColor" Value="Red" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Button Grid.Column="4" Text="Reponer" Clicked="Reponer" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>