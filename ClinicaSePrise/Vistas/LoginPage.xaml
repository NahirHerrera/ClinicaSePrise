<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.LoginPage"
             BackgroundColor="#F5F6F8"
             NavigationPage.HasNavigationBar="False">
    
    <Grid BackgroundColor="#F5F6F8">

    <Border VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="420"
                StrokeShape="RoundRectangle 10"
                Stroke="Transparent"
                BackgroundColor="White"
                Padding="30,25">
        <Border.Shadow>
            <Shadow Opacity="0.1" Radius="8" Offset="0,2" />
        </Border.Shadow>

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12">


                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Image Source="logo_clinica.jpeg"
                               HeightRequest="70"
                               WidthRequest="70"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />

                    <Label Text="Clínica SePrise"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               HorizontalOptions="Center" />

                    <Label Text="Salud y Cuidado"
                               FontSize="13"
                               TextColor="#64748B"
                               HorizontalOptions="Center" />
                </VerticalStackLayout>


                <Label Text="Iniciar Sesión"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           Margin="0,5,0,0" />


                <Border x:Name="FrameError"
                            BackgroundColor="#FEE2E2"
                            Stroke="#FCA5A5"
                            StrokeShape="RoundRectangle 8"
                            Padding="10"
                            IsVisible="False">
                    <Label x:Name="LblError"
                               Text="Usuario o contraseña incorrectos"
                               TextColor="#991B1B"
                               FontSize="13"
                               HorizontalOptions="Center" />
                </Border>


                <VerticalStackLayout Spacing="4">
                    <Label Text="Usuario"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />

                    <Border Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                        <Entry x:Name="TxtUsuario"
                                   Placeholder="Ej. jperez"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#1E293B"
                                   HeightRequest="42"
                                   ClearButtonVisibility="WhileEditing" />
                    </Border>
                </VerticalStackLayout>


                <VerticalStackLayout Spacing="4">
                    <Label Text="Contraseña"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />

                    <Border Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                        <Entry x:Name="TxtPassword"
                                   IsPassword="True"
                                   Placeholder="••••••••"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#1E293B"
                                   HeightRequest="42" />
                    </Border>
                </VerticalStackLayout>


                <Button x:Name="BtnIngresar"
                            Text="Ingresar al Sistema"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"
                            Margin="0,10,0,0"
                            Clicked="OnIngresarClicked" />


                <ActivityIndicator x:Name="IndicadorCarga"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#2563EB"
                                       HorizontalOptions="Center" />


                    <Label HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="¿No estás registrado? Hacé clic " TextColor="#64748B" />
                                <Span Text="aquí" TextColor="#2563EB" TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCrearCuentaTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
        </ScrollView>
    </Border>
    </Grid>
</ContentPage>