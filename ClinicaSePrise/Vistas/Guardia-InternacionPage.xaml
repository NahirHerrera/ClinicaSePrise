<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.Guardia_InternacionPage"
             BackgroundColor="#FEF2F2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <VerticalStackLayout Spacing="5">
                <Label x:Name="lblBienvenida" 
                       FontSize="14" 
                       TextColor="Gray" 
                       FontAttributes="Bold" />

                <Label Text="Gestión de Derivaciones a Estudios (Circuito B)" FontSize="22" FontAttributes="Bold" TextColor="#991B1B"/>
            </VerticalStackLayout>

            <Frame CornerRadius="10" Padding="15"
                   BackgroundColor="{AppThemeBinding Light=LightGrey, Dark=LightGrey}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nueva Derivación de Guardia/Internación" FontSize="16" FontAttributes="Bold"/>
                    <Entry Placeholder="DNI o N° Historia Clínica del Paciente"/>
                    <Picker Title="Origen de Derivación"
                            TitleColor="Black"
                            BackgroundColor="{AppThemeBinding Light=AliceBlue, Dark=AliceBlue}">
                        <Picker.Items>
                            <x:String>Guardia Médica</x:String>
                            <x:String>Internación Piso</x:String>
                            <x:String>UTI</x:String>
                        </Picker.Items>
                    </Picker>
                    <Picker Title="Estudio Solicitado (Circuito B)"
                            TitleColor="Black"
                            BackgroundColor="{AppThemeBinding Light=AliceBlue, Dark=AliceBlue}">
                        <Picker.Items>
                            <x:String>Laboratorio de Sangre Urgente</x:String>
                            <x:String>Radiografía de Tórax</x:String>
                            <x:String>Ecografía Abdominal</x:String>
                            <x:String>Electrocardiograma</x:String>
                        </Picker.Items>
                    </Picker>
                    <Button Text="Emitir Derivación Urgente" BackgroundColor="#DC2626" TextColor="White"/>
                </VerticalStackLayout>
            </Frame>


            <Frame CornerRadius="10" Padding="10" BackgroundColor="{AppThemeBinding Light=White, Dark=LightGrey}">
                <VerticalStackLayout>
                    <Label Text="Derivaciones" FontSize="16" FontAttributes="Bold" TextColor="DimGrey" />
                    <CollectionView x:Name="Derivaciones" ItemsLayout="VerticalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout>
                                    <VerticalStackLayout Spacing="4" Padding="10">
                                        <Label Text="{Binding NombreCompleto}" FontSize="13" TextColor="Black"/>
                                        <HorizontalStackLayout Spacing="12">
                                            <Label Text="Origen:" FontAttributes="Bold" FontSize="12" TextColor="Grey"/>
                                            <Label Text="{Binding Origen}" FontSize="12" TextColor="Grey"/>
                                            <Label Text="Estudio:" FontAttributes="Bold" FontSize="12" Margin="10,0,0,0" TextColor="Grey"/>
                                            <Label Text="{Binding EstudioNombre}" FontSize="12" TextColor="Grey"/>
                                            <Label Text="{Binding Estado}" FontSize="12" TextColor="Black"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <BoxView HeightRequest="10" BackgroundColor="#E0E0E0" HorizontalOptions="Fill" Margin="10,0"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>