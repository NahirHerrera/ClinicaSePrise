<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.Guardia_InternacionPage"
             Title="Guardia e Internación"
             BackgroundColor="#FEF2F2">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🚪 Cerrar Sesión" 
                 Clicked="OnCerrarSesionClicked" 
                 Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Encabezado con Saludo Dinámico -->
            <VerticalStackLayout Spacing="5">
                <Label x:Name="lblBienvenida" 
                       FontSize="14" 
                       TextColor="Gray" 
                       FontAttributes="Bold" />

                <Label Text="Gestión de Derivaciones a Estudios (Circuito B)" FontSize="22" FontAttributes="Bold" TextColor="#991B1B"/>
            </VerticalStackLayout>

            <Frame CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nueva Derivación de Guardia/Internación" FontSize="16" FontAttributes="Bold"/>
                    <Entry Placeholder="DNI o N° Historia Clínica del Paciente"/>
                    <Picker Title="Origen de Derivación">
                        <Picker.Items>
                            <x:String>Guardia Médica</x:String>
                            <x:String>Internación Piso</x:String>
                            <x:String>UTI</x:String>
                        </Picker.Items>
                    </Picker>
                    <Picker Title="Estudio Solicitado (Circuito B)">
                        <Picker.Items>
                            <x:String>Laboratorio de Sangre Urgente</x:String>
                            <x:String>Radiografía de Tórax</x:String>
                            <x:String>Ecografía Abdominal</x:String>
                            <x:String>Electrocardiograma</x:String>
                        </Picker.Items>
                    </Picker>
                    <Button Text="Emitir Derivación Urgente" BackgroundColor="#DC2626" TextColor="White" Clicked="OnEmitirDerivacionClicked"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>