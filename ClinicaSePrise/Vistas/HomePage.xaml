<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.HomePage"
             BackgroundColor="{StaticResource Fondo}">

    <ContentPage.Resources>
        <!-- Card conserva padding interno -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Borde}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="20" />
            <!-- PADDING INTERNO CONSERVADO -->
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="MenuItem" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="14,12" />
            <!-- padding interno del item -->
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="MenuText" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Gris}" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ContentPage.Resources>


    <Grid ColumnDefinitions="*">

        <ScrollView x:Name="VistaStaff" Grid.Column="0" BackgroundColor="Transparent" Margin="0" Padding="0">
            <VerticalStackLayout Padding="0" Spacing="12" Margin="0">

                <Label x:Name="lblBienvenida"
                       FontSize="14"
                       TextColor="Gray"
                       FontAttributes="Bold"
                       Margin="0" />

                <Grid ColumnDefinitions="*,Auto" Margin="0" Padding="0">
                    <Border Style="{StaticResource Card}" HeightRequest="48" HorizontalOptions="Fill">

                        <Entry Placeholder="Buscar pacientes por nombre o DNI..." HorizontalOptions="Fill" Margin="0" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Padding="0" Margin="0">
                        <Label Text="{Binding Usuario}" FontAttributes="Bold" HorizontalOptions="End" Margin="0" />
                        <Label Text="{Binding Rol}" FontSize="12" TextColor="{StaticResource Gris}" HorizontalOptions="End" Margin="0" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0" Padding="0">
                    <VerticalStackLayout Padding="0" Margin="0">
                        <Label Text="{Binding Fecha}" TextColor="{StaticResource Azul}" FontSize="13" Margin="0" />
                        <Label Text="{Binding Usuario, StringFormat='Buenos días, {0}'}" FontSize="32" Margin="0" />
                        <Label Text="Este es el resumen de actividad de hoy." TextColor="{StaticResource Gris}" Margin="0" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="+  Nuevo turno" BackgroundColor="{StaticResource Azul}"
                            TextColor="White" CornerRadius="10" HeightRequest="50" VerticalOptions="End"
                            Clicked="OnNuevoTurno" Margin="0" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="0" Padding="0">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                        <VerticalStackLayout Spacing="6" Padding="0" Margin="0">
                            <Label Text="Turnos de hoy" TextColor="{StaticResource Gris}" Margin="0" />
                            <Label Text="{Binding TurnosHoy}" FontSize="28" FontAttributes="Bold" Margin="0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                        <VerticalStackLayout Spacing="6" Padding="0" Margin="0">
                            <Label Text="Pacientes atendidos" TextColor="{StaticResource Gris}" Margin="0" />
                            <Label Text="{Binding Atendidos}" FontSize="28" FontAttributes="Bold" Margin="0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                        <VerticalStackLayout Spacing="6" Padding="0" Margin="0">
                            <Label Text="En sala de espera" TextColor="{StaticResource Gris}" Margin="0" />
                            <Label Text="{Binding EnEspera}" FontSize="28" FontAttributes="Bold" Margin="0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0">
                        <VerticalStackLayout Spacing="6" Padding="0" Margin="0">
                            <Label Text="Insumos críticos" TextColor="{StaticResource Gris}" Margin="0" />
                            <Label Text="{Binding InsumosCriticos}" FontSize="28" FontAttributes="Bold" Margin="0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="2*,*" ColumnSpacing="12" Margin="0" Padding="0">

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                        <VerticalStackLayout Spacing="8" Padding="0" Margin="0">
                            <Label Text="Próximos turnos" FontSize="18" Margin="0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Turnos}" Padding="0" Margin="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="80,*,*,100" Padding="0" Margin="0">
                                            <VerticalStackLayout Padding="0" Margin="0">
                                                <Label Text="{Binding Hora}" FontAttributes="Bold" Margin="0" />
                                                <Label Text="{Binding Duracion}" FontSize="12" TextColor="{StaticResource Gris}" Margin="0" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Padding="0" Margin="0">
                                                <Label Text="{Binding Paciente}" FontAttributes="Bold" Margin="0" />
                                                <Label Text="{Binding Dni}" FontSize="12" TextColor="{StaticResource Gris}" Margin="0" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Profesional}" Margin="0" />
                                            <Label Grid.Column="3" Text="{Binding Estado}" FontAttributes="Bold" TextColor="{StaticResource Azul}" Margin="0">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Confirmado">
                                                        <Setter Property="TextColor" Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="En espera">
                                                        <Setter Property="TextColor" Value="Orange" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                        <VerticalStackLayout Spacing="8" Padding="0" Margin="0">
                            <Label Text="Stock crítico" FontSize="18" Margin="0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stock}" Padding="0" Margin="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Padding="0" Margin="0">
                                            <VerticalStackLayout Padding="0" Margin="0">
                                                <Label Text="{Binding Nombre}" FontAttributes="Bold" Margin="0" />
                                                <Label Text="{Binding Sector}" FontSize="12" TextColor="{StaticResource Gris}" Margin="0" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Stock, StringFormat='{0} u.'}" TextColor="Red" VerticalOptions="Center" Margin="0" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>


        <ContentView x:Name="VistaPaciente" Grid.Column="0" Margin="0" IsVisible="False" />
    </Grid>
</ContentPage>
