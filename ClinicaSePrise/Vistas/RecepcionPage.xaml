<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:ClinicaSePrise.Entidades"
             x:Class="ClinicaSePrise.Vistas.RecepcionPage"
             Title="Recepción y Acreditación"
             BackgroundColor="#F8FAFC">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🚪 Cerrar Sesión"
                     Clicked="OnCerrarSesionClicked"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#E2E8F0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1E293B" />
        </Style>
        <Style x:Key="Ayuda" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#64748B" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="lblBienvenida" FontSize="14" TextColor="Gray" FontAttributes="Bold" />
                    <Label Text="Gestión de Recepción" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Actualizar" Clicked="OnActualizar" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">

                <!-- Turnos de hoy -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Turnos de hoy" Style="{StaticResource Titulo}" />
                        <SearchBar x:Name="sbPaciente" Placeholder="Buscar paciente por DNI o nombre..."
                                   TextChanged="OnBuscar" />
                        <CollectionView x:Name="cvTurnosHoy" SelectionMode="Single" HeightRequest="330"
                                        SelectionChanged="OnTurnoSeleccionado">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ent:TurnoRecepcion">
                                    <Grid ColumnDefinitions="56,*,*,100" ColumnSpacing="10" Padding="8,10">
                                        <Label Text="{Binding Hora}" FontAttributes="Bold" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Paciente}" FontAttributes="Bold" />
                                            <Label Text="{Binding Dni, StringFormat='DNI {0}'}" Style="{StaticResource Ayuda}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2">
                                            <Label Text="{Binding Profesional}" />
                                            <Label Text="{Binding Lugar}" Style="{StaticResource Ayuda}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="3" Text="{Binding Estado}" FontAttributes="Bold" TextColor="#2563EB" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Acreditar y cobrar -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Acreditar y cobrar" Style="{StaticResource Titulo}" />
                        <Label x:Name="lblSinSeleccion" Text="Elegí un turno de la lista." Style="{StaticResource Ayuda}" />

                        <VerticalStackLayout x:Name="stAcreditar" IsVisible="False" Spacing="8">
                            <Label x:Name="lblPacienteSel" FontSize="16" FontAttributes="Bold" />
                            <Label x:Name="lblTurnoSel" Style="{StaticResource Ayuda}" />
                            <Label x:Name="lblCoberturaSel" FontSize="13" />

                            <!-- Solo si viene por obra social: Recepción chequea si está al día -->
                            <HorizontalStackLayout x:Name="stObraSocial" Spacing="6">
                                <CheckBox x:Name="chkObraSocialAlDia" CheckedChanged="OnObraSocialCambiada" />
                                <Label Text="Obra social al día (si no, paga como particular)" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Entry x:Name="txtMonto" Placeholder="Monto a cobrar (sin puntos de miles)" Keyboard="Numeric" />
                            <Picker x:Name="pkMedioPago" Title="Medio de pago">
                                <Picker.Items>
                                    <x:String>Efectivo</x:String>
                                    <x:String>Tarjeta</x:String>
                                    <x:String>Transferencia</x:String>
                                </Picker.Items>
                            </Picker>

                            <Button x:Name="btnAcreditar" Text="Acreditar y pasar a sala" BackgroundColor="#16A34A"
                                    TextColor="White" Clicked="OnAcreditarClicked" />
                            <Button x:Name="btnAusente" Text="Marcar ausente (no vino)" BackgroundColor="White"
                                    TextColor="#DC2626" BorderColor="#FCA5A5" BorderWidth="1" Clicked="OnMarcarAusente" />
                            <Label x:Name="lblAvisoEstado" FontSize="12" TextColor="#B45309" />
                        </VerticalStackLayout>

                        <Label x:Name="lblComprobante" IsVisible="False" FontSize="13" TextColor="#166534" />
                    </VerticalStackLayout>
                </Border>

                <!-- Turnos a confirmar por teléfono -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Llamar para confirmar" Style="{StaticResource Titulo}" />
                        <Label Text="Turnos pendientes de los próximos 3 días." Style="{StaticResource Ayuda}" />
                        <VerticalStackLayout x:Name="stLlamados" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ent:LlamadoPendiente">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="4,8">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Paciente}" FontAttributes="Bold" />
                                            <Label Text="{Binding Detalle}" Style="{StaticResource Ayuda}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Confirmó" CommandParameter="Confirmó"
                                                Clicked="OnResultadoLlamado" VerticalOptions="Center" />
                                        <Button Grid.Column="2" Text="Canceló" CommandParameter="Canceló"
                                                Clicked="OnResultadoLlamado" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Sala de espera -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sala de espera" Style="{StaticResource Titulo}" />
                        <VerticalStackLayout x:Name="stSalaEspera" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ent:TurnoRecepcion">
                                    <Label>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Hora}" FontAttributes="Bold" />
                                                <Span Text="  " />
                                                <Span Text="{Binding Paciente}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding Profesional}" TextColor="#64748B" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
