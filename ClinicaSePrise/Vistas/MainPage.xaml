<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ClinicaSePrise.Vistas.MainPage"
    BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="SimpleButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <Style x:Key="LogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource SimpleButtonStyle}">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="ThinSeparator" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="#E0E0E0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="0"
          BackgroundColor="#F9F9F9"
          Padding="12"
          RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="6">

            <VerticalStackLayout Grid.Row="0"
                         Padding="6"
                         Spacing="2">
                <Label x:Name="LblDisplayNombre"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="#222"
                       LineBreakMode="TailTruncation" />

                <Label x:Name="LblRol"
                       FontSize="12"
                       TextColor="Gray"
                       LineBreakMode="TailTruncation" />

                <BoxView
                        Style="{StaticResource ThinSeparator}"
                        Margin="0,8,0,0" />
            </VerticalStackLayout>


            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="0">

                    <Button x:Name="BtnHome"
                    Text="Home"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaHome"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                    <Button x:Name="BtnPaciente"
                    Text="Paciente"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaPaciente"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                    <Button x:Name="BtnRecepcion"
                    Text="Recepción"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaRecepcion"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                    <Button x:Name="BtnMedico"
                    Text="Médico"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaMedico"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                    <Button x:Name="BtnGuardia"
                    Text="Guardia / Internación"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaGuardia"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                    <Button x:Name="BtnLaboratorio"
                    Text="Laboratorio"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaLaboratorio"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                    <Button x:Name="BtnAsistencial"
                    Text="Asistencial"
                    Style="{StaticResource SimpleButtonStyle}" />
                    <BoxView x:Name="LineaAsistencial"
                     HeightRequest="3"
                     Color="#1677D2"
                     IsVisible="False" />

                </VerticalStackLayout>
            </ScrollView>


            <Button 
                Grid.Row="2"
                x:Name="BtnCambiarTema"
                Style="{StaticResource SimpleButtonStyle}"
                Clicked="BtnCambiarTema_Clicked" />
            <Button 
                Grid.Row="3"
                x:Name="BtnCerrarSesion"
                Text="🚪 Cerrar Sesión"
                Style="{StaticResource LogoutButtonStyle}"
                TextColor="Black"
                Margin="0,8,0,0" />

        </Grid>


        <ContentView Grid.Column="1" x:Name="ContentArea" Padding="12">
            <Label Text="Bienvenido" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" TextColor="#222" />
        </ContentView>
    </Grid>
</ContentPage>