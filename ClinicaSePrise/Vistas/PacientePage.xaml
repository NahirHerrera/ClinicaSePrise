<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:e="clr-namespace:ClinicaSePrise.Entidades"
             x:Class="ClinicaSePrise.Vistas.PacientePage">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuperficieClaro}, Dark={StaticResource SuperficieOscuro}}" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />
        </Style>

        <Style x:Key="Sub" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ENCABEZADO -->
            <StackLayout VerticalOptions="Start" HorizontalOptions="Start" Margin="0,0,0,10">
                <Label x:Name="lblBienvenida" 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}" 
                       FontAttributes="Bold" />

                <Label Text="Clínica SePrise - Portal del paciente" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />

                <Label Text="Gestioná tus turnos y consultá tus comprobantes." 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}" />
            </StackLayout>

            <!-- SOLICITAR TURNO -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Solicitar turno" Style="{StaticResource Titulo}" />

                    <Label Text="Tipo de Atención"
                           TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"/>
                    <Picker x:Name="pkTipoAtencion"
                            Title="Seleccioná el tipo de atención"
                            SelectedIndexChanged="OnTipoAtencionChanged"
                            TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioOscuro}}"/>

                    <!-- SECCIÓN MÉDICA -->
                    <VerticalStackLayout x:Name="layoutMedico" Spacing="10">
                        <Label Text="Especialidad"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"/>
                        <Picker x:Name="pkEspecialidad"
                                SelectedIndexChanged="OnEspecialidad"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioOscuro}}"/>

                        <Label Text="Profesional" TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"/>
                        <Picker x:Name="pkProfesional"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedIndexChanged="BuscarSlots"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioOscuro}}"/>

                        <Label Text="Fecha del turno"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"/>
                        <DatePicker x:Name="dpFecha"
                                    DateSelected="BuscarSlots"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioOscuro}}"/>
                    </VerticalStackLayout>

                    <!-- SECCIÓN DIAGNÓSTICO POR IMÁGENES -->
                    <VerticalStackLayout x:Name="layoutImagen" Spacing="10" IsVisible="False">
                        <Label Text="Práctica / Estudio de Imágenes" />
                        <Picker x:Name="pkPracticaImagen"
                                Title="Seleccioná un estudio"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedIndexChanged="OnPracticaImagenChanged"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioOscuro}}"/>

                        <Label x:Name="lblIndicacion"
                               TextColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}"
                               FontAttributes="Bold"
                               IsVisible="False" />

                        <Label Text="Fecha del estudio"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"/>
                        <DatePicker x:Name="dpFechaImagen"
                                    DateSelected="BuscarSlotsImagen"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SecundarioClaro}, Dark={StaticResource SecundarioOscuro}}"/>
                    </VerticalStackLayout>

                    <Label Text="Horarios disponibles"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />

                    <!-- HORARIOS DINÁMICOS -->
                    <FlexLayout x:Name="ListaSlots" Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="e:Slot">
                                <Button Text="{Binding hora}"
                                        Clicked="OnSlotClicked"
                                        Margin="0,0,8,8"
                                        Padding="16,0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}"
                                        BorderColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}"
                                        BorderWidth="1"
                                        CornerRadius="12" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label x:Name="SinSlots"
                           Text="No hay horarios disponibles para ese día."
                           Style="{StaticResource Sub}"
                           IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"/>
                </VerticalStackLayout>
            </Border>

            <!-- MIS TURNOS -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Mis turnos" Style="{StaticResource Titulo}" />

                    <VerticalStackLayout x:Name="ListaTurnos" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding especialidad}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />
                                            <Label Text="{Binding nombreProfesional}" Style="{StaticResource Sub}" />
                                            <Label Text="{Binding Fecha}" Style="{StaticResource Sub}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                            <Label Text="{Binding estado}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}" HorizontalOptions="End" />
                                            <Button Text="Cancelar"
                                                    Clicked="Cancelar_Clicked"
                                                    IsVisible="{Binding PuedeCancelar}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource ErrorClaro}, Dark={StaticResource ErrorOscuro}}"
                                                    BorderColor="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}"
                                                    BorderWidth="1"
                                                    CornerRadius="12" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label x:Name="SinTurnos" Text="No tenés turnos." Style="{StaticResource Sub}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- COMPROBANTES DE PAGO -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Comprobantes de pago" Style="{StaticResource Titulo}" />

                    <VerticalStackLayout x:Name="ListaFacturas" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="e:Factura">
                                <Border Style="{StaticResource Card}" BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding concepto}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />
                                            <Label Text="{Binding detalle}" Style="{StaticResource Sub}" />
                                            <Label Text="{Binding nroComprobante}" Style="{StaticResource Sub}" FontSize="12" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                            <Label Text="{Binding montoTxt}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" HorizontalOptions="End" />
                                            <Label Text="{Binding estado}" TextColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label x:Name="SinFacturas" Text="No tenés comprobantes de pago." Style="{StaticResource Sub}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- COMPROBANTES DE ESTUDIO -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Comprobantes de estudio" Style="{StaticResource Titulo}" />

                    <VerticalStackLayout x:Name="ListaEstudios" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="e:ComprobanteEstudio">
                                <Border Style="{StaticResource Card}" BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding nombre}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}" />
                                            <Label Text="{Binding fecha}" Style="{StaticResource Sub}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1" Text="{Binding estado}" TextColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label x:Name="SinEstudios" Text="No tenés comprobantes de estudio." Style="{StaticResource Sub}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>