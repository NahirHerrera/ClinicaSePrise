<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.ConexionPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource SuperficieClaro}, Dark={StaticResource FondoOscuro}}">

    <Grid>
        <Border VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="420"
                StrokeShape="RoundRectangle 10"
                Stroke="{AppThemeBinding Light=Transparent, Dark={StaticResource BordeOscuro}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource SuperficieOscuro}}"
                Padding="30,25">
            <Border.Shadow>
                <Shadow Opacity="0.1" Radius="8" Offset="0,2" />
            </Border.Shadow>

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Configuración de Conexión"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"
                           Margin="0,5,0,0" />

                    <!-- Puerto -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Puerto"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Entry x:Name="txtPuerto"
                                   ClassId="SinBorde"
                                   Placeholder="Ingresa el Puerto"
                                   Keyboard="Numeric"
                                   Text="3306"
                                   TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Usuario -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Usuario"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Entry x:Name="txtUsuario"
                                   ClassId="SinBorde"
                                   Placeholder="Ingresa el Usuario"
                                   Keyboard="Text"
                                   Text="root"
                                   TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Contraseña -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Contraseña"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource BordeClaro}, Dark={StaticResource BordeOscuro}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource FondoClaro}, Dark={StaticResource FondoOscuro}}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Entry x:Name="txtPassword"
                                   ClassId="SinBorde"
                                   Placeholder="Ingresa la Contraseña"
                                   Keyboard="Text"
                                   IsPassword="True"
                                   Text=""
                                   TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextoSuaveClaro}, Dark={StaticResource TextoSuaveOscuro}}"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="enviar"
                            Text="Enviar"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarioClaro}, Dark={StaticResource PrimarioOscuro}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextoSobrePrimarioClaro}, Dark={StaticResource TextoSobrePrimarioOscuro}}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"
                            Margin="0,10,0,0"
                            Clicked="Enviar_Clicked" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
