<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicaSePrise.Vistas.ConexionPage"
             BackgroundColor="#F5F6F8">

    <Grid>
        <Border VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="420"
                StrokeShape="RoundRectangle 10"
                Stroke="Transparent"
                BackgroundColor="White"
                Padding="30,25">
            <Border.Shadow>
                <Shadow Opacity="0.1" Radius="8" Offset="0,2" />
            </Border.Shadow>

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Configuración de Conexión"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           Margin="0,5,0,0" />

                    <!-- Puerto -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Puerto"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Border Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Entry x:Name="txtPuerto"
                                   Placeholder="Ingresa el Puerto"
                                   Keyboard="Numeric"
                                   Text="3306"
                                   TextColor="#1E293B"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Usuario -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Usuario"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Border Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Entry x:Name="txtUsuario"
                                   Placeholder="Ingresa el Usuario"
                                   Keyboard="Text"
                                   Text="root"
                                   TextColor="#1E293B"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Contraseña -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Contraseña"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Border Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Entry x:Name="txtPassword"
                                   Placeholder="Ingresa la Contraseña"
                                   Keyboard="Text"
                                   IsPassword="True"
                                   Text=""
                                   TextColor="#1E293B"
                                   HeightRequest="42" />
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="enviar"
                            Text="Enviar"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"
                            Margin="0,10,0,0"
                            Clicked="Enviar_Clicked" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
