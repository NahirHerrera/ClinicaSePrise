<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:ClinicaSePrise.Entidades"
             x:Class="ClinicaSePrise.Vistas.LaboratorioPage"
             Title="Laboratorio">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🚪 Cerrar Sesión"
                     Clicked="OnCerrarSesionClicked"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">

        <Label Grid.Row="0" x:Name="lblBienvenida" FontSize="18" FontAttributes="Bold" />

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="20">

                <!-- COLUMNA IZQUIERDA: 1. INGRESO DE ORDEN Y COBRO -->
                <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Spacing="8">
                    <Label Text="1. Ingreso de orden (sin turno)" FontSize="20" FontAttributes="Bold" />

                    <!-- Búsqueda por DNI -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="entDni" Placeholder="DNI del paciente" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Buscar" Clicked="OnBuscarPaciente" />
                    </Grid>

                    <Label x:Name="lblPacNuevo" />

                    <!-- FORMULARIO DE REGISTRO RÁPIDO (Se muestra si el paciente no está registrado) -->
                    <VerticalStackLayout x:Name="stFormularioPaciente" IsVisible="False" Spacing="8" Margin="0,4,0,8">
                        <Label Text="Paciente no registrado. Ingrese los datos:" TextColor="Red" FontSize="13" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Grid.Column="0" x:Name="entNombre" Placeholder="Nombre" />
                            <Entry Grid.Column="1" x:Name="entApellido" Placeholder="Apellido" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Grid.Column="0" x:Name="pkSexo" Title="Sexo">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Masculino</x:String>
                                        <x:String>Femenino</x:String>
                                        <x:String>Otro</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <DatePicker Grid.Column="1" x:Name="dpFechaNacimiento" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker Grid.Column="0" x:Name="pkModalidadCobertura" Title="Cobertura">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Particular</x:String>
                                        <x:String>Obra Social</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <Entry Grid.Column="1" x:Name="entObraSocial" Placeholder="Nombre de Obra Social" />
                        </Grid>
                    </VerticalStackLayout>
                    <!-- FIN FORMULARIO DE REGISTRO -->

                    <!-- Listado de Prácticas / Determinaciones -->
                    <CollectionView x:Name="cvPracticas" SelectionMode="Multiple" HeightRequest="250">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="ent:PracticaLab">
                                <Label Padding="6" Text="{Binding Descripcion}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Entry x:Name="entMonto" Placeholder="Monto a cobrar" Keyboard="Numeric" />

                    <Picker x:Name="pkMedio" Title="Medio de pago">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Efectivo</x:String>
                                <x:String>Tarjeta</x:String>
                                <x:String>Transferencia</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Button Text="Cobrar y pasar a sala de espera" Clicked="OnRegistrar" />
                </VerticalStackLayout>


                <!-- COLUMNA DERECHA - ARRIBA: 2. SALA DE ESPERA -->
                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                    <Label Text="2. Sala de espera" FontSize="20" FontAttributes="Bold" />
                    <CollectionView x:Name="cvEspera" SelectionMode="Single"
                                    SelectionChanged="OnSeleccion" HeightRequest="280">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="ent:OrdenLab">
                                <Border Padding="10" Margin="0,4">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Paciente}" FontAttributes="Bold" />
                                        <Label Text="{Binding Practicas}" FontSize="12" />
                                        <Label Text="{Binding Estado}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>


                <!-- COLUMNA DERECHA - ABAJO: 3. ATENCIÓN, LLAMADO Y COMPROBANTE -->
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="12">
                    <Label Text="3. Atención" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="lblPaciente" Text="Seleccioná un paciente de la sala de espera" FontSize="16" />
                    <Label x:Name="lblPracticas" FontSize="13" TextColor="Gray" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="btnLlamar" Text="Llamar paciente" Clicked="OnLlamar" IsEnabled="False" />
                        <Button Grid.Column="1" x:Name="btnAtender" Text="Atender y emitir comprobante de retiro" Clicked="OnAtender" IsEnabled="False" />
                    </Grid>
                    <Border x:Name="bdComprobante" IsVisible="False" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Comprobante de retiro" FontAttributes="Bold" />
                            <Label x:Name="lblRetiro" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>